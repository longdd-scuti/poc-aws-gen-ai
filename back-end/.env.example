# Application Environment
APP_ENV=development
APP_CORS_ORIGINS=http://localhost:3000
AWS_REGION=us-east-1
AWS_PROFILE=bedrock-lab

# Security: IP Whitelisting (leave empty to allow all, or comma-separated IPs like 210.245.54.242)
ALLOWED_CLIENT_IPS=

# Routing Configuration (Screen 1)
# ROUTING_MODE options: auto | native | heuristic
ROUTING_MODE=auto
BEDROCK_PROMPT_ROUTER_ARN=
BEDROCK_FAST_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_SMART_MODEL_ID=amazon.nova-pro-v1:0
ROUTER_HEURISTIC_THRESHOLD=3

# Knowledge Base RAG Configuration (Screen 2)
BEDROCK_KNOWLEDGE_BASE_ID=
BEDROCK_RAG_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_MAX_OUTPUT_TOKENS=1024
BEDROCK_TEMPERATURE=0.2
RAG_NUMBER_OF_RESULTS=4
RAG_MAX_CONTEXT_CHARS=24000
